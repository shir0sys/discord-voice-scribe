DISCORD_TOKEN=

# Optionnel : si absent, l'audio est quand même enregistré, mais sans transcription.
# Chemin vers un modèle ggml de whisper.cpp (ex: ggml-base.bin).
WHISPER_MODEL=
# Nom du binaire whisper.cpp si différent de "whisper-cli" (certaines builds l'appellent "main").
WHISPER_BIN=whisper-cli
